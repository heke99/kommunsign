# Runtime
NODE_ENV=development
APP_ENV=development
KOMMUNSIGN_ENV=development
KOMMUNSIGN_RELEASE_VERSION=0.2.0
PLATFORM_WILDCARD_VERIFIED=false

# Canonical domains
KOMMUNSIGN_ROOT_DOMAIN=kommunsign.se
KOMMUNSIGN_DEFAULT_TENANT_DOMAIN_SUFFIX=kommunsign.se
KOMMUNSIGN_TENANT_DOMAIN_TEMPLATE={slug}.kommunsign.se
PUBLIC_WEBSITE_URL=http://localhost:3000
ONBOARDING_PORTAL_URL=http://localhost:3005
PLATFORM_ADMIN_URL=http://localhost:3001
TENANT_DISCOVERY_URL=http://localhost:3002
AUTH_BROKER_URL=http://localhost:3006
API_BASE_URL=http://localhost:8787
SIGNER_FALLBACK_URL=http://localhost:3003
VERIFICATION_PORTAL_URL=http://localhost:3004
DOCS_URL=http://localhost:3007
STATUS_URL=https://status.kommunsign.se
WEBHOOK_BASE_URL=http://localhost:8787

# Control plane and shared data plane
CONTROL_DATABASE_URL=postgresql://kommunsign:local-password@127.0.0.1:5433/kommunsign_control
DATA_DATABASE_URL=postgresql://kommunsign:local-password@127.0.0.1:5434/kommunsign_data
DATA_PLANE_ROUTING_MODE=control_plane_registry
TENANT_CONTEXT_REQUIRED=true
ALLOW_IN_MEMORY_RUNTIME=true
KMS_KEY_REFERENCE=vault://local/kommunsign/kms

# Built-in production runtime. Override only with a reviewed compatible module.
KOMMUNSIGN_PRODUCTION_ADAPTER_MODULE=./production-adapters/postgres/index.js
KOMMUNSIGN_OBJECT_STORAGE_ADAPTER_MODULE=../../adapters/supabase-storage.js
KOMMUNSIGN_QUEUE_ADAPTER_MODULE=../../adapters/postgres-queue.js
KOMMUNSIGN_SENSITIVE_DATA_ADAPTER_MODULE=../../adapters/aes-gcm-sensitive-data.js
SENSITIVE_DATA_ENCRYPTION_KEY_BASE64=
SENSITIVE_DATA_BLIND_INDEX_KEY_BASE64=
KOMMUNSIGN_WORKER_ADAPTER_MODULE=./postgres-production-adapter.js

# Supabase Storage (server-side only)
SUPABASE_DATA_PROJECT_URL=https://project-ref.supabase.co
SUPABASE_DATA_SERVICE_ROLE_KEY=replace-in-secret-store
STORAGE_PROVIDER=supabase
STORAGE_APPLICATION_QUARANTINE_BUCKET=application-quarantine
STORAGE_DOCUMENT_QUARANTINE_BUCKET=document-quarantine
STORAGE_CANONICAL_DOCUMENTS_BUCKET=canonical-documents
STORAGE_SIGNED_DOCUMENTS_BUCKET=signed-documents
STORAGE_VALIDATION_REPORTS_BUCKET=validation-reports
STORAGE_EVIDENCE_PACKAGES_BUCKET=evidence-packages
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=eu-north-1
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only-password

# Domain provider
DOMAIN_PROVIDER=vercel
VERCEL_API_TOKEN=replace-in-secret-store
VERCEL_TEAM_ID=replace-with-team-id
VERCEL_TENANT_GATEWAY_PROJECT_ID=replace-with-project-id
VERCEL_ROUTING_TARGET=tenant.kommunsign.se
CUSTOM_DOMAIN_VERIFICATION_PREFIX=_kommunsign-verification
CUSTOM_DOMAIN_HEALTHCHECK_INTERVAL_MINUTES=15
CUSTOM_DOMAIN_CERTIFICATE_WARNING_DAYS=30
PLATFORM_WILDCARD_VERIFIED=false
RESERVED_TENANT_SLUGS=www,admin,apply,app,api,auth,sign,verify,docs,status,hooks,mail,support,billing,test,staging,dev,internal,system,root,security,platform,public,static,assets,cdn

# Auth broker and host-only sessions
OIDC_CALLBACK_URL=https://auth.kommunsign.se/callback/oidc
SAML_CALLBACK_URL=https://auth.kommunsign.se/callback/saml
OIDC_STATE_SIGNING_KEY=replace-in-secret-store
OIDC_SESSION_ENCRYPTION_KEY=replace-in-secret-store
AUTH_CODE_SIGNING_KEY=replace-in-secret-store
MAGIC_LINK_SIGNING_KEY=replace-in-secret-store
CSRF_SIGNING_KEY=replace-in-secret-store
INTERNAL_GATEWAY_HMAC_KEY=replace-with-at-least-32-random-characters
INTERNAL_GATEWAY_MAX_CLOCK_SKEW_SECONDS=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# Proxy, host and cache policy
TRUST_PROXY=false
TRUSTED_PROXY_PROVIDER=none
REQUIRE_VERIFIED_FORWARDED_HOST=true
REJECT_UNKNOWN_HOSTS=true
REJECT_UNVERIFIED_CUSTOM_DOMAINS=true
DOMAIN_RESOLUTION_CACHE_TTL_MS=30000

# CORS and redirects
STATIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006
LOAD_CUSTOM_ORIGINS_FROM_CONTROL_DATABASE=true
REQUIRE_ACTIVE_DOMAIN_FOR_ORIGIN=true
ALLOW_WILDCARD_CORS=false
ALLOW_ARBITRARY_REDIRECTS=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:3005,http://localhost:3005

# Email
EMAIL_PROVIDER=replace-with-provider
EMAIL_API_KEY=replace-in-secret-store
EMAIL_DEFAULT_FROM=no-reply@notify.kommunsign.se
EMAIL_DEFAULT_REPLY_TO=support@kommunsign.se
EMAIL_PUBLIC_LINK_BASE=https://kommunsign.se
EMAIL_APPLICANT_LINK_BASE=https://apply.kommunsign.se
EMAIL_SIGNER_FALLBACK_LINK_BASE=https://sign.kommunsign.se
EMAIL_USE_TENANT_PRIMARY_DOMAIN=true
EMAIL_REQUIRE_VERIFIED_SENDER_DOMAIN=true
MAIL_SMTP_URL=smtp://127.0.0.1:1025

# Identity and signing providers
TIC_BASE_URL=https://id.tic.io/api/v1
TIC_API_KEY_SECRET_REF=vault://local/tic/api-key
TIC_WEBHOOK_SECRET_REF=vault://local/tic/webhook-secret
FREJA_ENVIRONMENT=test
FREJA_CLIENT_CERT_SECRET_REF=vault://local/freja/client-cert
FREJA_CLIENT_KEY_SECRET_REF=vault://local/freja/client-key
SIGN_SERVICE_URL=http://127.0.0.1:8081
VALIDATION_SERVICE_URL=http://127.0.0.1:8082
IDENTITY_SERVICE_URL=http://127.0.0.1:8083

# Workers
QUEUE_ENDPOINT=postgresql://kommunsign:local-password@127.0.0.1:5434/kommunsign_data
WORKER_ID=kommunsign-local-worker
WORKER_CLAIM_LIMIT=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_MILLISECONDS=1000

# Frontend-safe values only
NEXT_PUBLIC_PRODUCT_NAME=KommunSign
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_API_PATH=/api
NEXT_PUBLIC_AUTH_URL=http://localhost:3006
NEXT_PUBLIC_VERIFY_URL=http://localhost:3004
