{
  "version": 2,
  "projects": [
    {
      "name": "kommunsign-public",
      "domains": [
        "kommunsign.se",
        "www.kommunsign.se"
      ],
      "source": "apps/public-website"
    },
    {
      "name": "kommunsign-onboarding",
      "domains": [
        "apply.kommunsign.se"
      ],
      "source": "apps/onboarding-portal"
    },
    {
      "name": "kommunsign-platform-admin",
      "domains": [
        "admin.kommunsign.se"
      ],
      "source": "apps/platform-admin"
    },
    {
      "name": "kommunsign-auth",
      "domains": [
        "auth.kommunsign.se"
      ],
      "source": "apps/auth-portal"
    },
    {
      "name": "kommunsign-organization-portal",
      "domains": [
        "app.kommunsign.se",
        "*.kommunsign.se"
      ],
      "source": "apps/tenant-portal",
      "acceptsVerifiedCustomDomains": true
    },
    {
      "name": "kommunsign-signer",
      "domains": [
        "sign.kommunsign.se"
      ],
      "source": "apps/signer-portal"
    },
    {
      "name": "kommunsign-verification",
      "domains": [
        "verify.kommunsign.se"
      ],
      "source": "apps/verification-portal"
    },
    {
      "name": "kommunsign-docs",
      "domains": [
        "docs.kommunsign.se"
      ],
      "source": "docs"
    }
  ],
  "externalServices": [
    {
      "domains": [
        "api.kommunsign.se",
        "hooks.kommunsign.se"
      ],
      "service": "api-runtime"
    },
    {
      "domains": [
        "status.kommunsign.se"
      ],
      "service": "status-page"
    },
    {
      "domains": [
        "support.kommunsign.se"
      ],
      "service": "support-portal"
    },
    {
      "domains": [
        "notify.kommunsign.se"
      ],
      "service": "email-sending-domain"
    }
  ]
}
