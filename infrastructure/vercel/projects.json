{
  "version": 3,
  "projects": [
    {
      "name": "kommunsign-web",
      "source": ".",
      "deploymentModel": "single-project-host-routing",
      "domains": [
        "kommunsign.se",
        "www.kommunsign.se",
        "apply.kommunsign.se",
        "admin.kommunsign.se",
        "auth.kommunsign.se",
        "app.kommunsign.se",
        "sign.kommunsign.se",
        "verify.kommunsign.se",
        "*.kommunsign.se"
      ],
      "notes": "Alla statiska portaler byggs och deployas tillsammans. Host-baserade rewrites väljer portal."
    }
  ],
  "runtimeDeployment": {
    "name": "kommunsign-runtime",
    "type": "container-stack",
    "domains": ["api.kommunsign.se", "hooks.kommunsign.se"],
    "processes": ["api", "workers", "validation-service", "clamav", "gotenberg", "verapdf"],
    "notes": "En separat runtime-deployment krävs för långlivade workers och isolerade dokumenttjänster."
  },
  "managedExternalServices": ["Supabase PostgreSQL/Auth/Storage", "TIC BankID", "Resend"]
}
