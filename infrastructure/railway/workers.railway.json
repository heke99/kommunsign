{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/workers.Dockerfile",
    "watchPatterns": [
      "apps/workers/**",
      "apps/api/src/adapters/**",
      "apps/api/src/production-adapters/**",
      "packages/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "infrastructure/docker/workers.Dockerfile",
      "infrastructure/railway/workers.railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 15,
    "drainingSeconds": 60
  }
}
