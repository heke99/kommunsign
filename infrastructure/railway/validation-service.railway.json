{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/validation-service.Dockerfile",
    "watchPatterns": [
      "services/validation-service/**",
      "infrastructure/docker/validation-service.Dockerfile",
      "infrastructure/railway/validation-service.railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 15,
    "drainingSeconds": 30
  }
}
