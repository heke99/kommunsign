# Kommunsign SignService — private runtime service.
#
# This service holds signing key material. It is never published on a domain and
# never given a public port; only the worker reaches it, over the internal
# network. Values below are names only — no secret value belongs in this file.

PORT=8081

# Shared secret the worker presents as a Bearer token. Rotate with the worker.
SIGNSERVICE_TOKEN=

# Backend selection. Absent or unrecognised means the service refuses to sign.
KOMMUNSIGN_SIGNING_BACKEND=SWEDEN_CONNECT

# SOFTWARE | HSM | REMOTE_QSCD.
# Production refuses SOFTWARE outright: an advanced electronic signature is a
# claim about sole control of the key, and a file on a container filesystem does
# not support that claim. Test and staging may use SOFTWARE with a test CA.
KOMMUNSIGN_SIGNING_KEY_PROTECTION=

# Software key material (test and staging only). The keystore is mounted at
# runtime and is never committed; the repository verification gate refuses
# committed .p12/.jks/.pem files.
KOMMUNSIGN_SIGNING_KEYSTORE_PATH=
KOMMUNSIGN_SIGNING_KEYSTORE_PASSWORD=
KOMMUNSIGN_SIGNING_KEY_ALIAS=
KOMMUNSIGN_SIGNING_KEY_PASSWORD=

# PKCS#11 token configuration (HSM / remote QSCD). Mutually exclusive with the
# keystore path above.
KOMMUNSIGN_SIGNING_PKCS11_CONFIG=

# RFC 3161 timestamp authority. Without it the backend can only reach PAdES-B,
# and any policy requiring PAdES-T or above is refused rather than downgraded.
KOMMUNSIGN_SIGNING_TSA_URL=

APP_ENV=production
