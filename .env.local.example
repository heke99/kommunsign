# Kommunsign lokal utvecklingsmiljö
# Kopiera med: npm run env:local:init
# Denna fil innehåller inga produktionshemligheter och får aldrig användas i produktion.

NODE_ENV=development
APP_ENV=development
KOMMUNSIGN_ENV=local
KOMMUNSIGN_RELEASE_VERSION=0.2.0-local
PORT=8787
KOMMUNSIGN_API_BOOTSTRAP_MODULE=../../dist/apps/api/src/dev-runtime.js

# Lokala portaler
PUBLIC_WEBSITE_URL=http://localhost:3000
PLATFORM_ADMIN_URL=http://localhost:3001
TENANT_DISCOVERY_URL=http://localhost:3002
SIGNER_FALLBACK_URL=http://localhost:3003
VERIFICATION_PORTAL_URL=http://localhost:3004
ONBOARDING_PORTAL_URL=http://localhost:3005
AUTH_BROKER_URL=http://localhost:3006
API_BASE_URL=http://localhost:8787
WEBHOOK_BASE_URL=http://localhost:8787
DOCS_URL=http://localhost:3000
STATUS_URL=http://localhost:3000
SUPPORT_URL=http://localhost:3000/kontakt/
KOMMUNSIGN_ROOT_DOMAIN=localhost
KOMMUNSIGN_DEFAULT_TENANT_DOMAIN_SUFFIX=localhost
KOMMUNSIGN_TENANT_DOMAIN_TEMPLATE={slug}.localhost

# Lokala databaser från docker-compose.yml
CONTROL_DATABASE_URL=postgresql://kommunsign:local-change-me@127.0.0.1:5433/kommunsign_control
DATA_DATABASE_URL=postgresql://kommunsign:local-change-me@127.0.0.1:5434/kommunsign_data
DATA_PLANE_ROUTING_MODE=control_plane_registry
TENANT_CONTEXT_REQUIRED=true
ALLOW_IN_MEMORY_RUNTIME=true
QUEUE_ENDPOINT=redis://127.0.0.1:6379

# Lokal säkerhetskonfiguration. Ersätt alltid med separata secrets i produktion.
SENSITIVE_DATA_ENCRYPTION_KEY_BASE64=a29tbXVuc2lnbi1sb2NhbC1lbmNyeXB0aW9uLWtleSE=
SENSITIVE_DATA_BLIND_INDEX_KEY_BASE64=a29tbXVuc2lnbi1sb2NhbC1ibGluZC1pbmRleC1rZXk=
OIDC_STATE_SIGNING_KEY=local-only-oidc-state-signing-key-change-me
OIDC_SESSION_ENCRYPTION_KEY=local-only-oidc-session-key-change-me
AUTH_CODE_SIGNING_KEY=local-only-auth-code-key-change-me
MAGIC_LINK_SIGNING_KEY=local-only-magic-link-key-change-me
CSRF_SIGNING_KEY=local-only-csrf-signing-key-change-me
INTERNAL_GATEWAY_HMAC_KEY=local-only-gateway-hmac-key-change-me
VALIDATION_SERVICE_TOKEN=local-only-validation-token-change-me
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# Lokal ingress och CORS
TRUST_PROXY=false
TRUSTED_PROXY_PROVIDER=none
REQUIRE_VERIFIED_FORWARDED_HOST=false
REJECT_UNKNOWN_HOSTS=false
REJECT_UNVERIFIED_CUSTOM_DOMAINS=false
LOAD_CUSTOM_ORIGINS_FROM_CONTROL_DATABASE=false
REQUIRE_ACTIVE_DOMAIN_FOR_ORIGIN=false
ALLOW_WILDCARD_CORS=false
ALLOW_ARBITRARY_REDIRECTS=false
STATIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006
API_MAX_REQUEST_BYTES=157286400

# Supabase Auth. Fyll endast när du testar riktiga kontoinbjudningar lokalt.
AUTH_PUBLIC_SIGNUP_ENABLED=false
AUTH_LOGIN_URL=http://localhost:3006
AUTH_INVITE_REDIRECT_URL=http://localhost:3006/aktivera/
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:3006/aterstall/
SUPABASE_AUTH_PROJECT_URL=
SUPABASE_AUTH_PROJECT_REF=
SUPABASE_AUTH_ANON_KEY=
SUPABASE_AUTH_SERVICE_ROLE_KEY=
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
SUPABASE_AUTH_SITE_URL=http://localhost:3006
SUPABASE_AUTH_ALLOWED_REDIRECT_URLS=http://localhost:3006/aktivera/,http://localhost:3006/aterstall/
AUTH_SMTP_PROVIDER=mailpit
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=1025
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER_EMAIL=konto@localhost
AUTH_SMTP_SENDER_NAME=Kommunsign lokal
SUPERADMIN_EMAIL=
SUPERADMIN_DISPLAY_NAME=
SUPERADMIN_ALLOW_EXISTING_USER=false
SUPERADMIN_INVITE_REDIRECT_URL=http://localhost:3006/aktivera/?destination=localhost:3001
SUPERADMIN_BOOTSTRAPPED=false

# Lokal e-post
EMAIL_PROVIDER=development
EMAIL_DEFAULT_FROM=Kommunsign lokal <signering@localhost>
EMAIL_DEFAULT_REPLY_TO=support@localhost
EMAIL_OPEN_TRACKING=false
EMAIL_CLICK_TRACKING=false
EMAIL_DATA_RESIDENCY_APPROVED=false
EMAIL_PUBLIC_LINK_BASE=http://localhost:3000
EMAIL_APPLICANT_LINK_BASE=http://localhost:3005
EMAIL_SIGNER_FALLBACK_LINK_BASE=http://localhost:3003
EMAIL_USE_TENANT_PRIMARY_DOMAIN=false
EMAIL_REQUIRE_VERIFIED_SENDER_DOMAIN=false
EMAIL_GLOBAL_KILL_SWITCH=false
MAIL_SMTP_URL=smtp://127.0.0.1:1025

# BankID är alltid avstängt lokalt tills ett uttryckligt produktionstest görs.
TIC_BANKID_ENABLED=false
TIC_ENVIRONMENT=production
TIC_BASE_URL=https://id.tic.io/api/v1
TIC_API_KEY=
TIC_WEBHOOK_SECRET=
TIC_CALLBACK_URL=http://localhost:3003/bankid/callback
TIC_WEBHOOK_URL=http://localhost:8787/v1/provider-webhooks/tic/bankid
TIC_REQUEST_TIMEOUT_MS=10000
TIC_WEBHOOK_MAX_AGE_SECONDS=300
TIC_POLL_INTERVAL_MS=2000
TIC_GLOBAL_KILL_SWITCH=true

# Lokala dokumenttjänster. Gotenberg använder port 3007 för att inte krocka med onboarding på 3005.
DOCUMENT_MAX_BYTES_DEFAULT=52428800
DOCUMENT_MAX_BYTES_HARD=104857600
DOCUMENT_MAX_PAGES_DEFAULT=500
DOCUMENT_MAX_COUNT_PER_CASE=20
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
QPDF_COMMAND=qpdf
QPDF_TIMEOUT_MS=30000
GOTENBERG_URL=http://127.0.0.1:3007
GOTENBERG_TIMEOUT_MS=120000
GOTENBERG_HEALTH_URL=http://127.0.0.1:3007/health
VERAPDF_URL=http://127.0.0.1:8080
VERAPDF_VALIDATE_PATH=/api/validate/2b
VERAPDF_TIMEOUT_MS=120000
VERAPDF_HEALTH_URL=http://127.0.0.1:8080/health
VALIDATION_SERVICE_URL=http://127.0.0.1:8082
VALIDATION_SERVICE_HEALTH_URL=http://127.0.0.1:8082/health

# Workers
WORKER_ID=kommunsign-local-worker
WORKER_CLAIM_LIMIT=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_MILLISECONDS=1000
WORKER_CONSUMERS_READY=false

# Frontendvärden
NEXT_PUBLIC_PRODUCT_NAME=Kommunsign
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_API_PATH=http://localhost:8787
NEXT_PUBLIC_AUTH_URL=http://localhost:3006
NEXT_PUBLIC_VERIFY_URL=http://localhost:3004
