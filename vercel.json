{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "build/vercel",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.kommunsign.se; font-src 'self'; object-src 'none'; upgrade-insecure-requests",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Kommunsign-Deployment": "web-0.2.0"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.kommunsign.se https://ddawgwlyjaoaajwyunaw.supabase.co; font-src 'self'; object-src 'none'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/(?:[A-Za-z0-9_-]+/)*(?:app|qr|office-upload)\\.[A-Za-z0-9_-]{16}\\.(?:css|js)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Kommunsign-Portal": "public"
      },
      "dest": "/index.html"
    },
    {
      "src": "/login",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/login/",
        "X-Kommunsign-Portal": "tenant"
      },
      "status": 308
    },
    {
      "src": "/login/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/index.html",
      "headers": {
        "X-Kommunsign-Portal": "auth"
      }
    },
    {
      "src": "/aktivera",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/aktivera/",
        "X-Kommunsign-Portal": "tenant"
      },
      "status": 308
    },
    {
      "src": "/aktivera/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/aktivera/index.html",
      "headers": {
        "X-Kommunsign-Portal": "auth"
      }
    },
    {
      "src": "/aterstall",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/aterstall/",
        "X-Kommunsign-Portal": "tenant"
      },
      "status": 308
    },
    {
      "src": "/aterstall/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/aterstall/index.html",
      "headers": {
        "X-Kommunsign-Portal": "auth"
      }
    },
    {
      "src": "/auth-assets/(app\\.[A-Za-z0-9_-]{16}\\.(?:css|js))",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Kommunsign-Portal": "auth"
      }
    },
    {
      "src": "/auth-assets/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "auth"
      },
      "dest": "/__portals/auth/$1"
    },
    {
      "src": "/((?:app|office-upload)\\.[A-Za-z0-9_-]{16}\\.(?:css|js))",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/tenant/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Kommunsign-Portal": "tenant"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "tenant"
      },
      "dest": "/__portals/tenant/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "tenant"
      },
      "dest": "/__portals/tenant/index.html"
    },
    {
      "src": "/(app\\.[A-Za-z0-9_-]{16}\\.(?:css|js))",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "dest": "/__portals/admin/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Kommunsign-Portal": "admin"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "admin"
      },
      "dest": "/__portals/admin/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "admin"
      },
      "dest": "/__portals/admin/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/ansok/(.*)",
      "headers": {
        "Cache-Control": "no-store",
        "X-Kommunsign-Portal": "apply"
      },
      "dest": "/ansok/index.html"
    },
    {
      "src": "/signera/(.*)",
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Kommunsign-Portal": "sign"
      },
      "dest": "/signera/index.html"
    },
    {
      "src": "/verifiera/(.*)",
      "headers": {
        "Cache-Control": "no-store",
        "X-Kommunsign-Portal": "verify"
      },
      "dest": "/verifiera/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
