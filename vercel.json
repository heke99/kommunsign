{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "build/vercel",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.kommunsign.se; font-src 'self'; object-src 'none'; upgrade-insecure-requests",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "https://kommunsign.se/$1"
      },
      "status": 308
    },
    {
      "src": "/login",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/login/"
      },
      "status": 308
    },
    {
      "src": "/login/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/index.html"
    },
    {
      "src": "/aktivera",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/aktivera/"
      },
      "status": 308
    },
    {
      "src": "/aktivera/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/aktivera/index.html"
    },
    {
      "src": "/aterstall",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Location": "/aterstall/"
      },
      "status": 308
    },
    {
      "src": "/aterstall/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/auth/aterstall/index.html"
    },
    {
      "src": "/auth-assets/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/auth/$1"
    },
    {
      "src": "/(app\\.(?:css|js))",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "dest": "/__portals/tenant/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/tenant/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/tenant/index.html"
    },
    {
      "src": "/(app\\.(?:css|js))",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/admin/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/admin/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.kommunsign.se"
        }
      ],
      "headers": {
        "Cache-Control": "private, no-store"
      },
      "dest": "/__portals/admin/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
