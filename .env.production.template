# Kommunsign production foundation — copy to a secret-managed environment.
# Values ending in *_SECRET_REF are references resolved by the deployment platform.
# Never commit resolved credentials.
NODE_ENV=production
APP_ENV=production
KOMMUNSIGN_ENV=production
KOMMUNSIGN_RELEASE_VERSION=0.2.0
PORT=8787
KOMMUNSIGN_API_BOOTSTRAP_MODULE=../../dist/apps/api/src/production-runtime.js

# Canonical domains
KOMMUNSIGN_ROOT_DOMAIN=kommunsign.se
KOMMUNSIGN_DEFAULT_TENANT_DOMAIN_SUFFIX=kommunsign.se
KOMMUNSIGN_TENANT_DOMAIN_TEMPLATE={slug}.kommunsign.se
PUBLIC_WEBSITE_URL=https://kommunsign.se
ONBOARDING_PORTAL_URL=https://kommunsign.se/ansok/
PLATFORM_ADMIN_URL=https://admin.kommunsign.se
TENANT_DISCOVERY_URL=https://app.kommunsign.se
AUTH_BROKER_URL=https://app.kommunsign.se/login/
API_BASE_URL=https://api.kommunsign.se
SIGNER_FALLBACK_URL=https://kommunsign.se/signera/
VERIFICATION_PORTAL_URL=https://kommunsign.se/verifiera/
DOCS_URL=https://kommunsign.se/dokumentation/
STATUS_URL=https://kommunsign.se/driftstatus/
WEBHOOK_BASE_URL=https://api.kommunsign.se
SUPPORT_URL=https://kommunsign.se/kontakt/
EMAIL_SENDING_DOMAIN=notify.kommunsign.se

# Control plane and shared data plane
CONTROL_DATABASE_URL=
DATA_DATABASE_URL=
DATA_PLANE_ROUTING_MODE=control_plane_registry
TENANT_CONTEXT_REQUIRED=true
ALLOW_IN_MEMORY_RUNTIME=false
KMS_KEY_REFERENCE=
KOMMUNSIGN_PRODUCTION_ADAPTER_MODULE=./production-adapters/postgres/index.js
KOMMUNSIGN_OBJECT_STORAGE_ADAPTER_MODULE=../../adapters/supabase-storage.js
KOMMUNSIGN_QUEUE_ADAPTER_MODULE=../../adapters/postgres-queue.js
KOMMUNSIGN_SENSITIVE_DATA_ADAPTER_MODULE=../../adapters/aes-gcm-sensitive-data.js
KOMMUNSIGN_WORKER_ADAPTER_MODULE=./postgres-production-adapter.js
SENSITIVE_DATA_ENCRYPTION_KEY_BASE64=
SENSITIVE_DATA_BLIND_INDEX_KEY_BASE64=

# Supabase Storage — server-side only
SUPABASE_DATA_PROJECT_URL=
SUPABASE_DATA_SERVICE_ROLE_KEY=
STORAGE_PROVIDER=supabase
OBJECT_STORAGE_ENDPOINT=
STORAGE_APPLICATION_QUARANTINE_BUCKET=application-quarantine
STORAGE_DOCUMENT_QUARANTINE_BUCKET=document-quarantine
STORAGE_ORIGINAL_DOCUMENTS_BUCKET=original-documents
STORAGE_CANONICAL_DOCUMENTS_BUCKET=canonical-documents
STORAGE_SIGNED_DOCUMENTS_BUCKET=signed-documents
STORAGE_IDENTITY_EVIDENCE_BUCKET=identity-evidence
STORAGE_VALIDATION_REPORTS_BUCKET=validation-reports
STORAGE_EVIDENCE_PACKAGES_BUCKET=evidence-packages
SIGNED_URL_TTL_SECONDS=300

# Vercel domains / ingress
DOMAIN_PROVIDER=vercel
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_WEB_PROJECT_ID=
VERCEL_ROUTING_TARGET=kommunsign-web.vercel.app
PLATFORM_WILDCARD_VERIFIED=false
CUSTOM_DOMAIN_VERIFICATION_PREFIX=_kommunsign-verification
CUSTOM_DOMAIN_HEALTHCHECK_INTERVAL_MINUTES=15
CUSTOM_DOMAIN_CERTIFICATE_WARNING_DAYS=30
RESERVED_TENANT_SLUGS=www,admin,apply,app,api,auth,sign,verify,docs,status,hooks,notify,mail,support,billing,test,staging,dev,internal,system,root,security,platform,public,static,assets,cdn

# Managed accounts and password authentication (Supabase Auth)
SUPABASE_AUTH_PROJECT_URL=
SUPABASE_AUTH_PROJECT_REF=
SUPABASE_AUTH_ANON_KEY=
SUPABASE_AUTH_SERVICE_ROLE_KEY=
# Deployment-only Management API credentials. Do not expose them to application runtimes.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
SUPABASE_AUTH_REQUEST_TIMEOUT_MS=10000
AUTH_PUBLIC_SIGNUP_ENABLED=false
AUTH_LOGIN_URL=https://app.kommunsign.se/login/
AUTH_INVITE_REDIRECT_URL=https://app.kommunsign.se/aktivera/
AUTH_PASSWORD_RESET_REDIRECT_URL=https://app.kommunsign.se/aterstall/
AUTH_EMAIL_DELIVERY_VERIFIED=false
AUTH_SMTP_PROVIDER=resend
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=resend
AUTH_SMTP_PASSWORD_SECRET_REF=
# Resolved only while running auth:configure-production; remove from runtime after configuration.
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER_EMAIL=konto@notify.kommunsign.se
AUTH_SMTP_SENDER_NAME=Kommunsign
SUPABASE_AUTH_SITE_URL=https://app.kommunsign.se/login/
SUPABASE_AUTH_ALLOWED_REDIRECT_URLS=https://app.kommunsign.se/aktivera/,https://app.kommunsign.se/aterstall/
SUPERADMIN_BOOTSTRAPPED=false
SUPERADMIN_ALLOW_EXISTING_USER=false
SUPERADMIN_EMAIL=hekmat.h@div3rsa.com
SUPERADMIN_DISPLAY_NAME=Hekmat Hourani
SUPERADMIN_INVITE_REDIRECT_URL=https://app.kommunsign.se/aktivera/?destination=admin.kommunsign.se

# Authentication, CSRF and host-only sessions
OIDC_CALLBACK_URL=https://app.kommunsign.se/login/callback/oidc
SAML_CALLBACK_URL=https://app.kommunsign.se/login/callback/saml
OIDC_STATE_SIGNING_KEY=
OIDC_SESSION_ENCRYPTION_KEY=
AUTH_CODE_SIGNING_KEY=
MAGIC_LINK_SIGNING_KEY=
CSRF_SIGNING_KEY=
INTERNAL_GATEWAY_HMAC_KEY=
INTERNAL_GATEWAY_MAX_CLOCK_SKEW_SECONDS=60
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_MAX_AGE_SECONDS=28800

# Trusted proxy, hosts, CORS and redirects
TRUST_PROXY=true
# Railway terminates public API TLS and forwards the verified request context.
TRUSTED_PROXY_PROVIDER=railway
# Platform-injected by Railway. Do not set manually in Railway.
RAILWAY_ENVIRONMENT_ID=
# Required only for proxy providers that use an application-managed shared secret.
TRUSTED_PROXY_SHARED_SECRET=
REQUIRE_VERIFIED_FORWARDED_HOST=true
REJECT_UNKNOWN_HOSTS=true
REJECT_UNVERIFIED_CUSTOM_DOMAINS=true
DOMAIN_RESOLUTION_CACHE_TTL_MS=30000
STATIC_ALLOWED_ORIGINS=https://kommunsign.se,https://admin.kommunsign.se,https://app.kommunsign.se
LOAD_CUSTOM_ORIGINS_FROM_CONTROL_DATABASE=true
REQUIRE_ACTIVE_DOMAIN_FOR_ORIGIN=true
ALLOW_WILDCARD_CORS=false
ALLOW_ARBITRARY_REDIRECTS=false
CORS_ALLOWED_ORIGINS=https://admin.kommunsign.se,https://app.kommunsign.se,https://kommunsign.se
API_MAX_REQUEST_BYTES=157286400

# TIC BankID production. The secret manager resolves refs into TIC_API_KEY/TIC_WEBHOOK_SECRET at runtime.
TIC_BANKID_ENABLED=false
TIC_ENVIRONMENT=production
TIC_BASE_URL=https://id.tic.io/api/v1
TIC_API_KEY_SECRET_REF=
TIC_WEBHOOK_SECRET_REF=
TIC_API_KEY=
TIC_WEBHOOK_SECRET=
TIC_CALLBACK_URL=https://kommunsign.se/signera/bankid/callback
TIC_WEBHOOK_URL=https://api.kommunsign.se/v1/provider-webhooks/tic/bankid
TIC_REQUEST_TIMEOUT_MS=10000
TIC_WEBHOOK_MAX_AGE_SECONDS=300
TIC_POLL_INTERVAL_MS=2000
TIC_INTERNAL_TEST_TENANT_ID=
TIC_INTERNAL_TEST_SUBJECT_ALLOWLIST=
TIC_GLOBAL_KILL_SWITCH=false

# Provider-neutral email. Secret refs are resolved to runtime values.
EMAIL_PROVIDER=resend
RESEND_API_KEY_SECRET_REF=
RESEND_WEBHOOK_SECRET_REF=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DEFAULT_FROM="Kommunsign <signering@notify.kommunsign.se>"
EMAIL_DEFAULT_REPLY_TO=support@kommunsign.se
EMAIL_OPEN_TRACKING=false
EMAIL_CLICK_TRACKING=false
EMAIL_DATA_RESIDENCY_APPROVED=false
EMAIL_PUBLIC_LINK_BASE=https://kommunsign.se
EMAIL_APPLICANT_LINK_BASE=https://kommunsign.se/ansok/
EMAIL_SIGNER_FALLBACK_LINK_BASE=https://kommunsign.se/signera/
EMAIL_USE_TENANT_PRIMARY_DOMAIN=true
EMAIL_REQUIRE_VERIFIED_SENDER_DOMAIN=true
EMAIL_GLOBAL_KILL_SWITCH=false
MAIL_SMTP_URL=smtp://127.0.0.1:1025

# Document processing — internal network only
DOCUMENT_MAX_BYTES_DEFAULT=52428800
DOCUMENT_MAX_BYTES_HARD=104857600
DOCUMENT_MAX_PAGES_DEFAULT=500
DOCUMENT_MAX_COUNT_PER_CASE=20
CLAMAV_HOST=clamav.railway.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
QPDF_COMMAND=qpdf
QPDF_TIMEOUT_MS=30000
GOTENBERG_URL=http://gotenberg.railway.internal:3000
GOTENBERG_TIMEOUT_MS=120000
GOTENBERG_HEALTH_URL=http://gotenberg.railway.internal:3000/health
VERAPDF_URL=http://verapdf.railway.internal:8080
VERAPDF_VALIDATE_PATH=/api/validate/2b
VERAPDF_TIMEOUT_MS=120000
VERAPDF_HEALTH_URL=http://verapdf.railway.internal:8080/api/info
VALIDATION_SERVICE_URL=http://validation-service.railway.internal:8082
VALIDATION_SERVICE_TOKEN=
VALIDATION_SERVICE_HEALTH_URL=http://validation-service.railway.internal:8082/health

# Durable workers
QUEUE_ENDPOINT=
WORKER_ID=kommunsign-production-worker
WORKER_CLAIM_LIMIT=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_MILLISECONDS=1000
WORKER_CONSUMERS_READY=false

# Production readiness gates
PDF_PIPELINE_APPROVED=false
TIC_CALLBACK_VERIFIED=false
TIC_WEBHOOK_VERIFIED=false
WILDCARD_TLS_VERIFIED=false
AUDIT_CHAIN_VERIFIED=false
MIGRATIONS_CURRENT=false
EVIDENCE_VERIFIER_VERIFIED=false
PRODUCTION_ACCEPTANCE_TEST_PASSED=false
RETENTION_POLICY_APPROVED=false
DPA_ACCEPTED=false

# Live deployment verification (local/CI command only)
VERIFY_API=true

# Frontend-safe values only
NEXT_PUBLIC_PRODUCT_NAME=Kommunsign
NEXT_PUBLIC_SITE_URL=https://app.kommunsign.se
NEXT_PUBLIC_API_PATH=https://api.kommunsign.se
NEXT_PUBLIC_AUTH_URL=https://app.kommunsign.se/login/
