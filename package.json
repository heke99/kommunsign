{
  "name": "kommunsign",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant e-signature and digital approval platform for Swedish public sector",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "kommunsign-verify": "scripts/kommunsign-verify.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "prebuild": "npm run check:toolchain",
    "build": "tsc -p tsconfig.json && node scripts/build-portals.mjs",
    "test": "npm run build && node tests/run.mjs",
    "test:unit": "npm run test",
    "test:integration": "npm run build && node tests/integration.mjs",
    "test:e2e": "node scripts/test-category.mjs e2e",
    "test:security": "npm run build && node tests/security.mjs",
    "test:accessibility": "node scripts/test-category.mjs accessibility",
    "verify:repository": "node scripts/verify-repository.mjs",
    "verify:provenance": "node scripts/check-provenance.mjs",
    "verify:java": "bash scripts/build-java.sh",
    "verify": "npm run clean && npm run build && npm run verify:repository && npm run verify:migrations && npm run verify:provenance && npm run verify:sdk && npm run scan:secrets && npm run verify:java && node tests/run.mjs && node tests/integration.mjs && node tests/security.mjs",
    "package:release": "bash scripts/package-release.sh",
    "provenance:report": "node scripts/provenance-report.mjs",
    "verify:migrations": "node scripts/check-sql-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "dev": "node scripts/dev-all.mjs",
    "dev:website": "node scripts/serve-static.mjs apps/public-website/public 3000",
    "dev:platform-admin": "node scripts/serve-static.mjs apps/platform-admin/public 3001",
    "dev:tenant": "node scripts/serve-static.mjs apps/tenant-portal/public 3002",
    "dev:signer": "node scripts/serve-static.mjs apps/signer-portal/public 3003",
    "dev:verify": "node scripts/serve-static.mjs apps/verification-portal/public 3004",
    "dev:api": "npm run build && APP_ENV=development CORS_ALLOWED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002 KOMMUNSIGN_API_BOOTSTRAP_MODULE=../../dist/apps/api/src/dev-runtime.js node apps/api/server.mjs",
    "dev:workers": "npm run build && node dist/apps/workers/src/dev-runner.js",
    "db:up": "docker compose up -d postgres-control postgres-data redis minio clamav gotenberg mailpit",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:verify": "bash scripts/db-verify.sh",
    "db:reset:test": "bash scripts/db-reset-test.sh",
    "web:build": "node scripts/build-public-site.mjs",
    "web:dev": "npm run dev:website",
    "web:preview": "npm run web:build && node scripts/serve-static.mjs build/public-site 3000",
    "vercel-build": "npm run web:build",
    "portal:build": "node scripts/build-portals.mjs",
    "verify:sdk": "node scripts/verify-sdk-sync.mjs"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
